{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.faisalkhanzemi/insta-edits",
  "title": "Insta Edits for Claude",
  "description": "Let Claude edit Instagram Reels in Edits for Mac: the full 274-tool editor, kept in sync.",
  "repository": {
    "url": "https://github.com/faisalkhanzemi/insta-edits-for-claude",
    "source": "github"
  },
  "websiteUrl": "https://github.com/faisalkhanzemi/insta-edits-for-claude",
  "version": "0.1.1",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "insta-edits",
      "version": "0.1.1",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "EDITS_MCP_TOKEN",
          "description": "Access token from Edits › Settings › Automation",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        },
        {
          "name": "EDITS_MCP_URL",
          "description": "Edits automation endpoint (default http://127.0.0.1:19501/mcp)",
          "isRequired": false,
          "format": "string"
        }
      ]
    }
  ]
}
